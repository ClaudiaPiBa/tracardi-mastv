<button class=\"outline-button\" data-go=\"catalog\" type=\"button\">Ver todas las ofertas</button>\n      </section>\n\n      <section class=\"view catalog-view\" id=\"catalogView\" aria-labelledby=\"catalogTitle\" hidden=\"\">\n        <div class=\"catalog-banner\"><div class=\"catalog-banner__text\"><h1 id=\"catalogTitle\">Catálogo de<br>Ofertas</h1><p>Aprovecha las promociones exclusivas para ti</p></div><img class=\"gift-art\" src=\"img/regalo.svg\" alt=\"Regalo con moño rojo\"></div>\n        <div class=\"region-block\" aria-label=\"Ubicación de los beneficios\">\n          <p id=\"regionStatus\" class=\"region-status\">Sin región activa. Puedes explorar ofertas de todas las regiones.</p>\n          <button type=\"button\" id=\"changeLocation\" class=\"outline-button change-location\">Cambiar ubicación</button>\n          <p id=\"locationFeedback\" class=\"tracking-status\" role=\"status\" aria-live=\"polite\"></p>\n          <p class=\"location-attribution\">Resolución de región: <a href=\"https://nominatim.org/\" target=\"_blank\" rel=\"noopener noreferrer\">Nominatim</a>, © <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener noreferrer\">colaboradores de OpenStreetMap</a>.</p>\n        </div>\n        <div class=\"filter-block\"><h2>Filtrar por categoría:</h2><div class=\"filters\" id=\"categoryFilters\" role=\"group\" aria-label=\"Filtrar ofertas\"><button class=\"filter is-active\" type=\"button\" data-filter=\"Todos\" data-category-key=\"\" aria-pressed=\"true\">Todos</button><button class=\"filter\" type=\"button\" data-filter=\"Comida\" data-category-key=\"comida\" aria-pressed=\"false\">Comida</button></div></div>\n        <p class=\"catalog-status\" id=\"catalogStatus\" role=\"status\" aria-live=\"polite\"></p>\n        <p class=\"catalog-warning\" id=\"catalogWarning\" role=\"status\" hidden=\"\">Algunas ofertas no están disponibles porque su información está incompleta.</p>\n        <button class=\"outline-button retry-catalog\" id=\"retryCatalog\" type=\"button\" hidden=\"\">Reintentar carga</button>\n        <div class=\"offer-list\" id=\"offerList\" aria-busy=\"false\"><article class=\"offer-card\"><div class=\"offer-card__head\"><div class=\"offer-card__logo offer-card__logo--promo\" aria-hidden=\"true\"><span hidden=\"\">🍽️</span><img class=\"offer-card__image\" alt=\"\" src=\"http://localhost:1337/uploads/qa-horizontal.svg\"></div><div class=\"offer-card__heading\"><h3>QA beneficio HORIZONTAL</h3><p>QA comercio sintético</p></div></div><p class=\"offer-card__description\">QA descripción HORIZONTAL</p><div class=\"tag-row\"><span class=\"tag\">Comida</span><span class=\"tag tag--discount\">15% de descuento</span></div><p class=\"offer-card__discount\">15% de descuento</p><button class=\"offer-card__button\" type=\"button\">Ver beneficio</button></article><article class=\"offer-card\"><div class=\"offer-card__head\"><div class=\"offer-card__logo offer-card__logo--promo\" aria-hidden=\"true\"><span hidden=\"\">🍽️</span><img class=\"offer-card__image\" alt=\"\" src=\"http://localhost:1337/uploads/qa-vertical.svg\"></div><div class=\"offer-card__heading\"><h3>QA beneficio VERTICAL-V4</h3><p>QA comercio sintético</p></div></div><p class=\"offer-card__description\">QA descripción VERTICAL-V4</p><div class=\"tag-row\"><span class=\"tag\">Comida</span><span class=\"tag tag--discount\">15% de descuento</span></div><p class=\"offer-card__discount\">15% de descuento</p><button class=\"offer-card__button\" type=\"button\">Ver beneficio</button></article></div>\n        <p class=\"empty-state\" id=\"emptyState\" hidden=\"\">Todavía no hay recomendaciones personalizadas. Explora las categorías disponibles para descubrir beneficios.</p>\n      </section>\n\n      <section class=\"view detail-view\" id=\"detailView\" aria-labelledby=\"detailTitle\" hidden=\"\">\n        <div class=\"detail-card\"><button class=\"back-pill\" id=\"backToCatalog\" type=\"button\">← Volver al Catálogo de ofe